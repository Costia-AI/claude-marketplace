{
  "name": "@costia/claude-plugin",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Source of the costia Claude Code plugin. Built into one dependency-free ESM file at plugins/costia/dist/costia.mjs.",
  "scripts": {
    "build": "rm -rf ../../plugins/costia/dist && bun build src/main.ts --target=node --format=esm --minify --splitting --outdir=../../plugins/costia/dist --entry-naming=costia.mjs --chunk-naming=chunk-[hash].mjs",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
